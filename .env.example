# Copy to .env and adjust. Used by docker compose ${VAR} substitution.

APP_TITLE=Container Control
APP_SUBTITLE=Your containers · Managed access

# Empty names if you only use labels
ALLOWED_CONTAINERS=

# Optional extra display filter: comma-separated key=value pairs (OR).
# NOT needed for projects listed in COOLIFY_PROJECTS (those are shown + deployable).
# Use it only if you want to see containers you can't redeploy, or non-project labels.
# FILTER_LABEL=cat4dev
FILTER_LABEL=

# Always hidden (plus auto self-detect)
EXCLUDE_CONTAINERS=container-ui

LOG_TAIL=200

# Coolify API deploy fallback (optional). Deploy is keyed on the project name,
# so it works even after Coolify's garbage collector removed the containers.
# The project is read from the container's coolify.projectName (or
# com.docker.compose.project) label.
# COOLIFY_API_URL=http://192.168.1.11:8000
# COOLIFY_API_TOKEN=your-deploy-only-token
# COOLIFY_FORCE=false
# Projects allowed to be redeployed from this dashboard. Also a watchlist:
# each project here always gets a card, shown as "Missing" when Docker has no
# containers for it (GC), with a Deploy button to bring it back. Comma-separated.
# COOLIFY_PROJECTS=cat4dev,core
COOLIFY_PROJECTS=
