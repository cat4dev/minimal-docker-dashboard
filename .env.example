# Copy to .env and adjust. Used by docker compose ${VAR} substitution.

APP_TITLE=Container Control
APP_SUBTITLE=Your containers · Managed access

# Empty names if you only use labels
ALLOWED_CONTAINERS=

# Comma-separated key=value pairs (OR). Example:
# FILTER_LABEL=com.docker.compose.project=cat4dev,com.docker.compose.project=core
FILTER_LABEL=

# Always hidden (plus auto self-detect)
EXCLUDE_CONTAINERS=container-ui

LOG_TAIL=200
